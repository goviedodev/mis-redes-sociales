<Layouts.app flash={@flash}>
  <div class="space-y-8">
    <div class="flex items-center justify-between gap-2">
      <div class="space-y-1">
        <h1 class="text-2xl font-bold">Mis Redes Sociales</h1>
        <p class="text-sm opacity-75">Guarda y organiza tus enlaces favoritos</p>
      </div>
      <.link navigate={~p"/admin"} id="go-to-admin" class="btn btn-outline btn-sm">
        <.icon name="hero-cog-6-tooth" class="w-4 h-4" /> Categorías
      </.link>
    </div>

    <div role="tablist" class="tabs tabs-box grid grid-cols-2">
      <button
        type="button"
        id="tab-new"
        role="tab"
        phx-click="switch_tab"
        phx-value-tab="new"
        class={["tab font-medium", @active_tab == "new" && "tab-active"]}
      >
        Nuevo Enlace
      </button>
      <button
        type="button"
        id="tab-saved"
        role="tab"
        phx-click="switch_tab"
        phx-value-tab="saved"
        class={["tab font-medium", @active_tab == "saved" && "tab-active"]}
      >
        Enlaces Guardados
      </button>
    </div>

    <div
      id="new-link-panel"
      class={["card bg-base-200 p-4 rounded-2xl shadow-sm", @active_tab != "new" && "hidden"]}
    >
      <h2 class="text-lg font-semibold mb-3">Nuevo Enlace</h2>
      <.form for={@form} id="link-form" phx-change="validate" phx-submit="save" class="space-y-3">
        <.input
          field={@form[:category]}
          type="select"
          label="Categoría"
          prompt="Selecciona una categoría"
          options={@categories}
        />
        <.input
          field={@form[:subcategory]}
          type="text"
          label="Subcategoría (Opcional)"
          placeholder="Ej. OCR"
        />
        <.input
          field={@form[:link_type]}
          type="select"
          label="Tipo de Enlace"
          prompt="Selecciona una red social"
          options={@link_types}
        />
        <.input
          field={@form[:url]}
          type="url"
          label="Enlace (URL)"
          placeholder="https://www.youtube.com/..."
        />
        <.input
          field={@form[:short_description]}
          type="text"
          label="Descripción Corta"
          placeholder="Ej. AI Creator Studio"
        />
        <.input
          field={@form[:long_description]}
          type="textarea"
          label="Descripción Larga (Opcional)"
          placeholder="Notas detalladas sobre el enlace..."
        />
        <div class="space-y-1">
          <label class="label text-sm font-medium">Archivo Adjunto (Opcional)</label>
          <.live_file_input
            upload={@uploads.artifact}
            class="file-input file-input-bordered w-full"
          />
          <div :for={entry <- @uploads.artifact.entries} class="text-xs opacity-75">
            {entry.client_name}
          </div>
        </div>
        <button id="submit-link" type="submit" class="btn btn-primary w-full">
          Guardar Enlace
        </button>
      </.form>
    </div>

    <div id="saved-links-panel" class={["space-y-4", @active_tab != "saved" && "hidden"]}>
      <h2 class="text-lg font-semibold">Enlaces Guardados</h2>

      <div class="card bg-base-200 p-3 rounded-xl shadow-xs">
        <.form for={@filter_form} id="filter-form" phx-change="filter" class="space-y-2">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <.input
              field={@filter_form[:category]}
              type="select"
              label="Categoría"
              prompt="Todas las categorías"
              options={@categories}
            />
            <.input
              field={@filter_form[:subcategory]}
              type="text"
              label="Subcategoría"
              placeholder="Filtrar subcategoría..."
            />
            <.input
              field={@filter_form[:link_type]}
              type="select"
              label="Tipo de Enlace"
              prompt="Todos los tipos"
              options={@link_types}
            />
          </div>
          <div class="flex justify-end">
            <button
              type="button"
              id="clear-filters"
              phx-click="clear_filters"
              class="btn btn-ghost btn-xs"
            >
              Limpiar filtros
            </button>
          </div>
        </.form>
      </div>

      <div id="links" phx-update="stream" class="space-y-3">
        <div id="links-empty" class="hidden only:block text-sm opacity-60 py-4 text-center">
          No hay enlaces guardados aún.
        </div>
        <div
          :for={{id, link} <- @streams.links}
          id={id}
          class="card bg-base-200 p-4 rounded-xl shadow-xs space-y-2"
        >
          <%= if @editing_link_id == link.id do %>
            <.form
              for={@edit_form}
              id={"edit-form-#{link.id}"}
              phx-submit="save_edit"
              class="space-y-3"
            >
              <.input
                field={@edit_form[:category]}
                type="select"
                label="Categoría"
                options={@categories}
              />
              <.input
                field={@edit_form[:subcategory]}
                type="text"
                label="Subcategoría (Opcional)"
              />
              <.input
                field={@edit_form[:link_type]}
                type="select"
                label="Tipo de Enlace"
                options={@link_types}
              />
              <.input field={@edit_form[:url]} type="url" label="Enlace (URL)" />
              <.input
                field={@edit_form[:short_description]}
                type="text"
                label="Descripción Corta"
              />
              <.input
                field={@edit_form[:long_description]}
                type="textarea"
                label="Descripción Larga (Opcional)"
              />
              <div class="flex justify-end gap-2">
                <button
                  type="button"
                  id={"cancel-edit-#{link.id}"}
                  phx-click="cancel_edit"
                  phx-value-id={link.id}
                  class="btn btn-ghost btn-sm"
                >
                  Cancelar
                </button>
                <button type="submit" class="btn btn-primary btn-sm">
                  Guardar cambios
                </button>
              </div>
            </.form>
          <% else %>
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="badge badge-primary">{link.category}</span>
                <span :if={link.subcategory} data-role="subcategory" class="badge badge-secondary">
                  {link.subcategory}
                </span>
              </div>
              <div class="flex items-center gap-1">
                <span class="badge badge-outline">{link.link_type}</span>
                <button
                  type="button"
                  id={"edit-link-#{link.id}"}
                  phx-click="edit_link"
                  phx-value-id={link.id}
                  class="btn btn-ghost btn-xs"
                  aria-label="Editar enlace"
                >
                  <.icon name="hero-pencil-square" class="w-4 h-4" />
                </button>
                <button
                  type="button"
                  id={"delete-link-#{link.id}"}
                  phx-click="delete_link"
                  phx-value-id={link.id}
                  class="btn btn-ghost btn-xs text-error"
                  aria-label="Eliminar enlace"
                >
                  <.icon name="hero-trash" class="w-4 h-4" />
                </button>
              </div>
            </div>
            <p class="font-semibold text-base">{link.short_description}</p>
            <p
              :if={link.long_description}
              data-role="long-description"
              class="text-sm opacity-80 whitespace-pre-line"
            >
              {link.long_description}
            </p>
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="link link-primary text-sm break-all"
            >
              {link.url}
            </a>
            <div :if={link.artifact_path}>
              <a
                href={"/artifacts/#{link.artifact_path}"}
                target="_blank"
                rel="noopener noreferrer"
                data-role="artifact-link"
                class="btn btn-xs btn-outline gap-1"
              >
                <.icon name="hero-paper-clip" class="w-3.5 h-3.5" />
                {link.artifact_name}
              </a>
            </div>
          <% end %>
        </div>
      </div>

      <dialog :if={@deleting_link} id="delete-confirm-modal" class="modal modal-open">
        <div class="modal-box space-y-4">
          <h3 class="text-lg font-bold">Confirmar eliminación</h3>
          <p class="text-sm">
            ¿Estás seguro de que deseas eliminar <strong>{@deleting_link.short_description}</strong>?
          </p>
          <div class="modal-action">
            <button
              type="button"
              id="cancel-delete-link"
              phx-click="cancel_delete"
              class="btn btn-ghost btn-sm"
            >
              Cancelar
            </button>
            <button
              type="button"
              id="confirm-delete-link"
              phx-click="confirm_delete"
              class="btn btn-error btn-sm"
            >
              Aceptar
            </button>
          </div>
        </div>
      </dialog>
    </div>
  </div>
</Layouts.app>
