<Layouts.app flash={@flash}>
  <div class="space-y-8">
    <div class="flex items-center justify-between gap-2">
      <div class="space-y-1">
        <h1 class="text-2xl font-bold">Mis Redes Sociales</h1>
        <p class="text-sm opacity-75">Guarda y organiza tus enlaces favoritos</p>
      </div>
      <.link navigate={~p"/admin"} id="go-to-admin" class="btn btn-outline btn-sm">
        <.icon name="hero-cog-6-tooth" class="w-4 h-4" /> Categorías
      </.link>
    </div>

    <div class="card bg-base-200 p-4 rounded-2xl shadow-sm">
      <h2 class="text-lg font-semibold mb-3">Nuevo Enlace</h2>
      <.form for={@form} id="link-form" phx-change="validate" phx-submit="save" class="space-y-3">
        <.input
          field={@form[:category]}
          type="select"
          label="Categoría"
          prompt="Selecciona una categoría"
          options={@categories}
        />
        <.input
          field={@form[:subcategory]}
          type="text"
          label="Subcategoría (Opcional)"
          placeholder="Ej. OCR"
        />
        <.input
          field={@form[:link_type]}
          type="select"
          label="Tipo de Enlace"
          prompt="Selecciona una red social"
          options={@link_types}
        />
        <.input
          field={@form[:url]}
          type="url"
          label="Enlace (URL)"
          placeholder="https://www.youtube.com/..."
        />
        <.input
          field={@form[:short_description]}
          type="text"
          label="Descripción Corta"
          placeholder="Ej. AI Creator Studio"
        />
        <.input
          field={@form[:long_description]}
          type="textarea"
          label="Descripción Larga (Opcional)"
          placeholder="Notas detalladas sobre el enlace..."
        />
        <button id="submit-link" type="submit" class="btn btn-primary w-full">
          Guardar Enlace
        </button>
      </.form>
    </div>

    <div class="space-y-3">
      <h2 class="text-lg font-semibold">Enlaces Guardados</h2>
      <div id="links" phx-update="stream" class="space-y-3">
        <div id="links-empty" class="hidden only:block text-sm opacity-60 py-4 text-center">
          No hay enlaces guardados aún.
        </div>
        <div
          :for={{id, link} <- @streams.links}
          id={id}
          class="card bg-base-200 p-4 rounded-xl shadow-xs space-y-2"
        >
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="badge badge-primary">{link.category}</span>
              <span :if={link.subcategory} data-role="subcategory" class="badge badge-secondary">
                {link.subcategory}
              </span>
            </div>
            <span class="badge badge-outline">{link.link_type}</span>
          </div>
          <p class="font-semibold text-base">{link.short_description}</p>
          <p
            :if={link.long_description}
            data-role="long-description"
            class="text-sm opacity-80 whitespace-pre-line"
          >
            {link.long_description}
          </p>
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="link link-primary text-sm break-all"
          >
            {link.url}
          </a>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
